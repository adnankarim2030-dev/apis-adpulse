# --- Database ---
# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://apis_user:apis_password@localhost:5432/apis_db?schema=public"

# --- Authentication ---
# Long random string used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"
# Name of the cookie that stores the session token (safe to leave as-is)
AUTH_COOKIE_NAME="apis_session"

# --- Application ---
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Reserved for later phases (do not remove; automation/notification/AI modules read these) ---
REDIS_URL="redis://localhost:6379"
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
AI_API_KEY=""
STORAGE_PROVIDER=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
